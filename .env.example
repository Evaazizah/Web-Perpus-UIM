# ========================================================
# KONFIGURASI FIREBASE CLOUD (PERPUSTAKAAN DIGITAL UIM)
# ========================================================
# Cara mendapatkan kredensial:
# 1. Buka https://console.firebase.google.com/
# 2. Buat / Pilih Proyek Anda (misal: "uim-digilib")
# 3. Klik menu Project Settings (Ikon Gerigi) -> General
# 4. Gulir ke bawah ke bagian "Your apps", pilih Web (</>)
# 5. Salin nilai firebaseConfig ke variabel di bawah ini:

VITE_FIREBASE_API_KEY=your-firebase-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your-messaging-sender-id
VITE_FIREBASE_APP_ID=your-app-id

# ========================================================
# OPSIONAL: Konfigurasi Supabase (Jika Menggunakan Supabase)
# ========================================================
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
